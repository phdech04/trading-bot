# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# IBKR does NOT use API keys. The bot connects over a local socket to a running
# IB Gateway or Trader Workstation (TWS) instance, which handles authentication.
# You must have Gateway/TWS running (and its API enabled) before starting the bot.

# Where IB Gateway / TWS is listening.
IBKR_HOST=127.0.0.1

# Port decides paper vs live (check your Gateway/TWS API settings):
#   7497 = TWS paper      7496 = TWS live
#   4002 = Gateway paper  4001 = Gateway live
IBKR_PORT=7497

# Any integer; must be unique per simultaneous connection to the same Gateway/TWS.
IBKR_CLIENT_ID=1

# Your account ID (optional but recommended). Paper accounts usually start with "DU".
IBKR_ACCOUNT=

# "paper" (default) or "live". Live ALSO requires typing LIVE when run_live.py asks.
TRADING_MODE=paper

# --- Sentiment module (optional) -------------------------------------------
# Google AI Studio key for the Gemini sentiment scorer (free tier is fine).
GEMINI_API_KEY=your-gemini-key-here

# "gemini" (default, needs GEMINI_API_KEY) or "ollama" (local, needs Ollama running).
SENTIMENT_PROVIDER=gemini

# --- Alerts (optional) ------------------------------------------------------
# Slack/Telegram-style webhook URL. Leave empty to disable alerts.
ALERT_WEBHOOK_URL=
